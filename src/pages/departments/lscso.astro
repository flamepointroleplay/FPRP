---
import Layout from "../../layouts/Layout.astro";
---

<Layout
  title="Los Santos County Sheriff's Office | Flame Point Roleplay"
  description="The Los Santos County Sheriff's Office at Flame Point Roleplay — coming soon."
  active="lscso"
>
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow reveal">Departments</p>
      <h1 class="reveal">Los Santos County Sheriff's Office</h1>
      <p class="hero-sub reveal">This department isn't open yet — check back soon.</p>
    </div>
  </section>

  <section class="section" style="padding-top: 0;">
    <div class="container" style="max-width: 640px; text-align: center;">
      <div class="card">
        <p class="section-kicker">Coming Soon</p>
        <h2 style="margin-bottom: 10px;">Under Construction</h2>
        <p style="margin-bottom: 0;">
          LSCSO details, ranks, and how to join will be posted here once the department opens.
          Keep an eye on Discord for the announcement.
        </p>
      </div>
      <div class="hero-actions" style="margin-top: 32px;">
        <a href="https://discord.gg/5GKxAhPa4" class="btn btn-primary btn-lg" target="_blank" rel="noopener">Join Our Discord</a>
      </div>
    </div>
  </section>
</Layout>
